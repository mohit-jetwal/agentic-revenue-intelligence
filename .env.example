# =============================================================================
# Agentic Revenue Intelligence - environment configuration
#
# Copy to .env and edit:   Copy-Item .env.example .env
#
# Nested settings use a double underscore:  SECTION__FIELD
# Everything below is optional; the defaults shown are what the app uses
# when the variable is absent. Nothing here is required to run Step 1.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
#   environment drives the DI container:
#     local      -> Parquet/DuckDB, local MLflow, Chroma      (Stage 1)
#     databricks -> Delta/Databricks SQL, UC, Model Serving   (Stage 2)
# -----------------------------------------------------------------------------
APP__ENVIRONMENT=local
APP__DEBUG=false

# -----------------------------------------------------------------------------
# LLM (Claude). Not required until Stage 1 Step 14.
# Never commit a real key - .env is git-ignored.
# -----------------------------------------------------------------------------
LLM__PROVIDER=claude
LLM__API_KEY=
LLM__MODEL=claude-sonnet-5
LLM__PLANNER_MODEL=claude-opus-5
LLM__TEMPERATURE=0.0
LLM__MAX_TOKENS=4096
LLM__TIMEOUT_SECONDS=60
LLM__MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Data access
#   parquet_root : analytical facts (read by DuckDB)
#   app_database_url : application state - investigations, traces, feedback
# -----------------------------------------------------------------------------
DATA__PARQUET_ROOT=data/local/gold
DATA__DUCKDB_PATH=data/local/analytics.duckdb
DATA__APP_DATABASE_URL=sqlite:///data/local/app_state.sqlite
DATA__QUERY_TIMEOUT_SECONDS=30
DATA__MAX_RESULT_ROWS=100000

# -----------------------------------------------------------------------------
# ML / MLflow. Stage 2 sets tracking_uri to "databricks".
# -----------------------------------------------------------------------------
# SQLite, not the bare "file:./mlruns" store - current MLflow refuses that
# outright, and the model registry never supported it.
ML__TRACKING_URI=sqlite:///data/local/mlflow.db
ML__REGISTRY_URI=
ML__EXPERIMENT_NAME=agentic-revenue-intelligence
ML__MODEL_STAGE=Production
ML__ARTIFACT_ROOT=mlartifacts

# -----------------------------------------------------------------------------
# Agent execution budget (loop prevention - see brief section 18)
# -----------------------------------------------------------------------------
AGENT__MAX_ITERATIONS=12
AGENT__MAX_TOOL_CALLS=25
AGENT__MAX_EXECUTION_SECONDS=300
AGENT__MAX_TOKEN_BUDGET=200000

# Critic-driven re-plans before the loop is ended by the cap rather than by the
# Critic. A Critic that is never satisfied is how an agent loops forever.
AGENT__MAX_REPLANS=2
# Absolute profit impact above which a recommendation needs a person. Applied to
# the magnitude: giving up 1M is as consequential as chasing it.
AGENT__HUMAN_APPROVAL_THRESHOLD=1000000

# -----------------------------------------------------------------------------
# Vector store (enterprise RAG)
# -----------------------------------------------------------------------------
VECTORSTORE__BACKEND=chroma
VECTORSTORE__PATH=data/local/chroma
VECTORSTORE__COLLECTION=commercial_policies
VECTORSTORE__TOP_K=5

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__JSON_LOGS=true
OBSERVABILITY__TRACE_ENABLED=true

# -----------------------------------------------------------------------------
# Databricks (Stage 2 only - leave blank for local development)
# Use a Databricks secret scope / service principal in production.
# -----------------------------------------------------------------------------
DATABRICKS__HOST=
DATABRICKS__TOKEN=
DATABRICKS__WAREHOUSE_ID=
DATABRICKS__CATALOG=cpg_revenue_intelligence
DATABRICKS__GOLD_SCHEMA=gold
DATABRICKS__FEATURES_SCHEMA=features
DATABRICKS__ML_SCHEMA=ml
DATABRICKS__VECTOR_SEARCH_ENDPOINT=
